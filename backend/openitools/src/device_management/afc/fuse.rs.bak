use fuser::{
    FileAttr, FileType, Filesystem, ReplyAttr, ReplyData, ReplyDirectory, ReplyEntry, Request,
};
use openitools_idevice::afc::{AfcClient, AfcFopenMode, PathInfo};
use std::collections::HashMap;
use std::ffi::{c_int, OsStr};
use std::sync::Arc;
use std::time::{Duration, SystemTime, UNIX_EPOCH};
use tokio::io::{AsyncReadExt, AsyncSeekExt};
use tokio::sync::Mutex;

const ENOENT: c_int = 2;
const EIO: c_int = 5;

const TTL: Duration = Duration::from_secs(1); // 1 second

const HELLO_DIR_ATTR: FileAttr = FileAttr {
    ino: 1,
    size: 0,
    blocks: 0,
    atime: UNIX_EPOCH, // 1970-01-01 00:00:00
    mtime: UNIX_EPOCH,
    ctime: UNIX_EPOCH,
    crtime: UNIX_EPOCH,
    kind: FileType::Directory,
    perm: 0o755,
    nlink: 2,
    uid: 501,
    gid: 20,
    rdev: 0,
    flags: 0,
    blksize: 512,
};

const HELLO_TXT_CONTENT: &str = "Hello World!\n";

const HELLO_TXT_ATTR: FileAttr = FileAttr {
    ino: 2,
    size: 13,
    blocks: 1,
    atime: UNIX_EPOCH, // 1970-01-01 00:00:00
    mtime: UNIX_EPOCH,
    ctime: UNIX_EPOCH,
    crtime: UNIX_EPOCH,
    kind: FileType::RegularFile,
    perm: 0o644,
    nlink: 1,
    uid: 501,
    gid: 20,
    rdev: 0,
    flags: 0,
    blksize: 512,
};

#[derive(Debug)]
pub enum AfcCommandResult {
    ReadFile(Vec<u8>),
    FileInfo(PathInfo),
}

#[derive(Debug)]
pub enum AfcCommand {
    ReadFile {
        path: String,
        offset: i64,
        size: u32,
    },
    FileInfo(String),
}

#[derive(Debug)]
pub struct AfcFS {
    inode_map: HashMap<u64, String>,
    reverse_map: HashMap<String, u64>,
    afc: Arc<Mutex<AfcClient>>,

    async_handle: Arc<tokio::runtime::Handle>,
}

impl AfcFS {
    pub fn new(
        files_path: Vec<String>,
        afc: AfcClient,
        async_handle: tokio::runtime::Handle,
    ) -> Self {
        let mut inode_map = HashMap::new();
        let mut reverse_map = HashMap::new();

        // give each file its own stable inode
        for (i, path) in files_path.iter().enumerate() {
            let ino = (i + 2) as u64; // start at inode 2
            inode_map.insert(ino, path.clone());
            reverse_map.insert(path.trim_start_matches('/').to_string(), ino);
        }
        dbg!(Self {
            inode_map,
            reverse_map,
            afc: Arc::new(Mutex::new(afc)),
            async_handle: Arc::new(async_handle)
        })
    }
}

impl Filesystem for AfcFS {
    fn lookup(&mut self, _req: &Request, parent: u64, name: &OsStr, reply: ReplyEntry) {
        println!("looking up: {name:#?}");
        println!("parent: {parent}");
        if parent != 1 {
            reply.error(ENOENT);
            return;
        }

        let filename = name.to_str().unwrap();

        if let Some(&ino) = self.reverse_map.get(filename) {
            let path = self.inode_map[&ino].clone();

            let (tx, rx) = crossfire::mpmc::bounded_tx_async_rx_blocking(1);

            let rt = Arc::clone(&self.async_handle);
            let afc = Arc::clone(&self.afc);
            rt.spawn(async move {
                let file_info = afc.lock().await.get_file_info(path).await.unwrap();
                tx.send(file_info).await.unwrap();
            });

            let file_info: PathInfo = rx.recv().unwrap().into();

            println!("info: {file_info:#?}");
            reply.entry(&TTL, &file_info.to_fuse_file_attr(ino), 0)
        } else {
            reply.error(ENOENT);
        }
    }

    fn getattr(&mut self, _req: &Request, ino: u64, _fh: Option<u64>, reply: ReplyAttr) {
        println!("attr");
        if ino == 1 {
            println!("ino 1");
            let attr = FileAttr {
                ino: 1,
                size: 0,
                blocks: 0,
                atime: SystemTime::now(),
                mtime: SystemTime::now(),
                ctime: SystemTime::now(),
                crtime: SystemTime::now(),
                kind: FileType::Directory,
                perm: 0o655,
                nlink: 2,
                uid: 501,
                gid: 20,
                rdev: 0,
                flags: 0,
                blksize: 512,
            };
            reply.attr(&TTL, &attr);
            return;
        }

        if let Some(path) = self.inode_map.get(&ino).cloned() {
            let (tx, rx) = crossfire::mpmc::bounded_tx_async_rx_blocking(1);

            let rt = Arc::clone(&self.async_handle);
            let afc = Arc::clone(&self.afc);
            rt.spawn(async move {
                let file_info = afc.lock().await.get_file_info(path).await.unwrap();
                tx.send(file_info).await.unwrap();
            });

            let file_info: PathInfo = rx.recv().unwrap().into();
            reply.attr(&TTL, &file_info.to_fuse_file_attr(ino));
            // match file_info {
            //     Ok(info) => reply.attr(&TTL, &info.to_fuse_file_attr(ino)),
            //     Err(_) => reply.error(ENOENT),
            // }
        }
    }

    fn read(
        &mut self,
        _req: &Request,
        ino: u64,
        _fh: u64,
        offset: i64,
        size: u32,
        _flags: i32,
        _lock: Option<u64>,
        reply: ReplyData,
    ) {
        println!("reading");
        let Some(path) = self.inode_map.get(&ino).cloned() else {
            reply.error(ENOENT);
            return;
        };

        let (tx, rx) = crossfire::mpmc::bounded_tx_async_rx_blocking(1);
        let rt = Arc::clone(&self.async_handle);
        let afc = Arc::clone(&self.afc);

        rt.spawn(async move {
            let mut afc_lock = afc.lock().await;
            let mut remote_file = afc_lock
                .open(path, AfcFopenMode::RdOnly)
                .await
                .map_err(|e| {
                    eprintln!("afc open failed: {e}");
                    EIO
                })
                .unwrap();
            println!("opened the file");
            let mut buf = vec![0u8; size as usize];

            if let Err(e) = remote_file
                .seek(std::io::SeekFrom::Start(offset as _))
                .await
            {
                eprintln!("seek failed: {e}");
            };

            println!("seeked");

            let n = match remote_file.read(&mut buf).await {
                Ok(n) => n,
                Err(e) => {
                    panic!("read failed: {e}");
                }
            };
            println!("read the file: {} bytes", n);

            buf.truncate(n);
            tx.send(buf).await.unwrap();
        });

        let data = rx.recv().unwrap();
        reply.data(&data);
    }

    fn readdir(
        &mut self,
        _req: &Request,
        ino: u64,
        _fh: u64,
        offset: i64,
        mut reply: ReplyDirectory,
    ) {
        println!("read dir");
        if ino != 1 {
            println!("not 1");
            reply.error(ENOENT);
            return;
        }

        let mut entries = vec![
            (1, FileType::Directory, "."),
            (1, FileType::Directory, ".."),
        ];

        for (path, &ino) in &self.reverse_map {
            entries.push((ino, FileType::RegularFile, path.as_str()));
        }

        println!("entries: {entries:#?}");

        for (i, (inode, kind, name)) in entries.into_iter().enumerate().skip(offset as usize) {
            if reply.add(inode, (i + 1) as i64, kind, name) {
                break;
            }
        }

        reply.ok();
    }
}

